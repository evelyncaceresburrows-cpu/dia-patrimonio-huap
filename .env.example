# =================================================================
# Día del Patrimonio HUAP — Variables de entorno
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA subas .env.local al repositorio.
# =================================================================

# ---- Supabase (Base de datos) ----
# Project Settings → API en supabase.com
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...REEMPLAZAR...
# La anon key NO es requerida por el backend; solo si en el futuro se usa cliente directo.
SUPABASE_ANON_KEY=eyJhbGciOi...REEMPLAZAR...

# ---- Resend (envío de correo) ----
# Generada en resend.com → API Keys
RESEND_API_KEY=re_REEMPLAZAR

# Remitente verificado en Resend (debe estar verificado en tu dominio
# o usar el sandbox onboarding@resend.dev mientras no haya dominio propio)
RESEND_FROM="HUAP Patrimonio <onboarding@resend.dev>"

# ---- Correo destino institucional ----
# Donde llegan las notificaciones de cada testimonio recibido
CONTACT_EMAIL_TO=evelyncaceresburrows@gmail.com

# ---- Anti-spam (opcional pero recomendado) ----
# Si lo dejas vacío, el endpoint omite la verificación.
# hCaptcha o Cloudflare Turnstile — elegir uno
TURNSTILE_SECRET_KEY=
